FLASK_APP=app:create_app
SECRET_KEY=generate-a-random-secret-before-running
PRIVATE_KEY_ENCRYPTION_KEY=generate-a-separate-fernet-key-before-running
DATABASE_URL=sqlite:///project.db
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
SESSION_COOKIE_SECURE=false
